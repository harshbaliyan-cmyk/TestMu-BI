# =============================================================================
# TestMu BI — server configuration template
#
# Copy to `server/.env` and fill in real values. NEVER commit the filled copy;
# `.gitignore` excludes it, and every *.env* variant, on purpose.
#
# Every value below is a placeholder. If you can read a secret in this file,
# it is a bug — report it rather than using it.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Exact browser origin allowed to call this API with credentials.
# REQUIRED in production — the server refuses to start without it, because a
# permissive CORS origin plus cookie auth is a cross-site data-theft primitive.
CLIENT_ORIGIN=http://localhost:5173

# Public base URL of this server. Only needed for Tableau webhooks, which
# Tableau Cloud delivers by POSTing to it from the internet. Must be an
# absolute https:// address that resolves publicly — localhost and private
# addresses are refused, because Tableau would accept the registration and
# then never be able to deliver to it.
APP_BASE_URL=

# Number of reverse proxies in front of this process. Secure cookies and
# per-IP rate limiting both need the real client address. Leave 0 when running
# directly; set to the actual hop count behind a load balancer. Never guess
# high — an over-count lets clients spoof X-Forwarded-For and evade throttling.
TRUSTED_PROXY_HOPS=0

# ---- Database ---------------------------------------------------------------
# PostgreSQL connection string. Contains a password: environment only, never
# in source, never in a client bundle, never in a log line.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_SSL=true
DATABASE_POOL_SIZE=10

# ---- Sessions ---------------------------------------------------------------
# Signs the session cookie. Anyone who knows this value can forge a session for
# any user, so it must be unique per environment and never shared or reused.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In production the server refuses to boot if this is short or left as a
# placeholder.
SESSION_SECRET=replace-with-48-random-bytes-base64url
SESSION_COOKIE_NAME=testmu.sid
SESSION_MAX_AGE_HOURS=8

# ---- Authentication ---------------------------------------------------------
# Google OAuth client ID. This one IS public by design (it ships to the
# browser); the matching client *secret* is not used by this app and must
# never be added here. Leave as "mock" to disable Google sign-in.
GOOGLE_CLIENT_ID=mock

# Restrict sign-up/sign-in to a single email domain. Empty allows any domain.
ALLOWED_DOMAIN=example.com

# Comma-separated addresses granted the admin role.
ADMIN_EMAILS=admin@example.com

# Brute-force thresholds. Counted per IP and per email independently; either
# tripping locks the attempt out for AUTH_LOCKOUT_MINUTES.
AUTH_IP_MAX_ATTEMPTS=20
AUTH_EMAIL_MAX_ATTEMPTS=5
AUTH_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=15

# ---- Tableau ----------------------------------------------------------------
# AES-256-GCM key encrypting Tableau PATs at rest in the database.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every stored PAT undecryptable — reconnect each source
# afterwards. Must be exactly 32 bytes once base64-decoded, and must have no
# leading or trailing whitespace.
TABLEAU_CREDENTIAL_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Fallback Tableau server URL for scripts/rotate-tableau-secrets.mjs, used only
# when no connection is stored in the database yet. Day-to-day Tableau
# connections are created per user in the app and stored encrypted in Postgres.
TABLEAU_SERVER=https://your-site.online.tableau.com

# ---- Scheduling -------------------------------------------------------------
# Polling fallback for Tableau sources. Webhooks are the fast path; this cron
# is the safety net when delivery breaks. Default: every 2 hours.
TABLEAU_SOURCE_SYNC_CRON=0 */2 * * *
CRON_TZ_OFFSET=UTC

# ---- Email notifications ----------------------------------------------------
# Out-of-band alerts for security-sensitive account events (password changed,
# password reset by an admin, account created, account deleted). This is what
# lets the real owner notice a takeover: an attacker who controls the session
# does not control the mailbox.
#
# Leave SMTP_HOST empty to disable. Nothing breaks when it is unset — the
# security action still completes, and the server warns once at startup.
#
# Messages deliberately carry NO password, temporary password or token. Email
# is not a confidential channel; a credential mailed is a credential published.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TestMu BI <no-reply@example.com>
