# =============================================================================
# TestMu BI — client configuration template
#
# Vite inlines any variable prefixed VITE_ into the JavaScript bundle it ships
# to the browser. Anything here is therefore PUBLIC: readable by every visitor
# in devtools, and permanent once deployed.
#
# Never put a database URL, API secret, PAT, service-role key, Stripe secret
# key, or signing secret behind a VITE_ prefix. Server-only values belong in
# server/.env, which is never bundled.
# =============================================================================

# Google OAuth client ID. Public by design — it identifies the app, it does not
# authenticate it. The matching client SECRET must never appear in this file.
# The server is the source of truth for this value (served from /api/auth/config);
# this entry exists only for local overrides.
VITE_GOOGLE_CLIENT_ID=mock
